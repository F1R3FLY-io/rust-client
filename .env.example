# ====================
# F1r3fly Node Connection
# ====================
# Read by ConnectionConfig::from_env() in the library, and by the CLI as
# fallbacks for its flags. Variables marked CLI-only are not read by the library.

# Deploy node's gRPC endpoint, http:// or https:// (default: http://localhost:40401)
FIREFLY_GRPC_URL=http://localhost:40401

# Deploy node's HTTP endpoint, optionally with a base path (default: http://localhost:40403)
FIREFLY_HTTP_URL=http://localhost:40403

# Signing key: a file holding its hex (refused if group or others can read it),
# or the hex itself. Set exactly one: both set is an error, in the library and the CLI.
# FIREFLY_PRIVATE_KEY_FILE=/path/to/private_key.hex
FIREFLY_PRIVATE_KEY=

# HTTP endpoint of a second node polled for a deploy's verdict, such as a
# shard's read-only node (default: none; only the deploy node is polled)
# FIREFLY_OBSERVER_URL=http://localhost:40453

# PEM file of the certificate authorities trusted for https endpoints, in place
# of the bundled public roots. Refused when any endpoint is http://.
# FIREFLY_CA_CERT=/path/to/ca.pem

# Seconds a connection may take to establish, and one request may take (defaults: 10, 30)
# FIREFLY_CONNECT_TIMEOUT=10
# FIREFLY_REQUEST_TIMEOUT=30

# Maximum seconds to wait for a deploy to reach a terminal state (default: 90)
# FIREFLY_FINALIZATION_TIMEOUT=90

# Shard deploys are signed for: the node's casper.shard-name (default: root)
# FIREFLY_SHARD_ID=root

# CLI-only: a node's internal gRPC API, where propose is served
# (default: http://localhost:40402)
# FIREFLY_INTERNAL_GRPC_URL=http://localhost:40402

# CLI-only: the read-only node that exploratory-deploy, bonds, wallet-balance and
# the other read-only queries go to (no default)
# FIREFLY_READONLY_GRPC_URL=http://localhost:40452
# FIREFLY_READONLY_HTTP_URL=http://localhost:40453

# CLI-only: config file of named profiles, and the profile to use
# (default file: $XDG_CONFIG_HOME/f1r3fly/node_cli.toml or ~/.config/f1r3fly/node_cli.toml;
# default profile: the file's default_profile)
# FIREFLY_CONFIG=/path/to/node_cli.toml
# FIREFLY_PROFILE=local

# ====================
# Integration suite
# ====================
# Read by tests/integration, not by the library.

# Node image the suite's shard runs (default: f1r3flyindustries/f1r3fly-rust:dev)
# FIREFLY_NODE_IMAGE=f1r3flyindustries/f1r3fly-rust:dev

# Leave the shard running after the suite finishes, for debugging
# FIREFLY_KEEP_SHARD=1
